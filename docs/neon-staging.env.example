# Preview branch only. Never enable on a production target.
SHIKIMOMO_NEON_STAGING=true
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_STAGING_BACKEND=neon
SHIKIMOMO_STAGING_DATABASE_URL=postgresql://staging_gateway:REPLACE@YOUR_HOST.neon.tech/shikimomo_staging?sslmode=require

# Optional private image adapter; preview branch only. Do not paste credentials in chat.
# Requires explicit authorization to transmit the branch credential to the host's Secret settings.
# SHIKIMOMO_MEDIA_ENDPOINT=https://YOUR_STAGING_BRANCH.storage.c-7.us-east-2.aws.neon.tech
# SHIKIMOMO_MEDIA_ACCESS_KEY=<branch-scoped-token-id>
# SHIKIMOMO_MEDIA_SECRET_KEY=<branch-scoped-storage-secret>
# Existing Supabase account path remains disabled unless separately commissioned:
# MARKETPLACE_MEDIA_ENABLED=false
